<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, viewport-fit=cover">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="Margin">
<meta name="theme-color" content="#08171F">
<meta name="description" content="Margin — a private, local-first envelope budget and debt tracker.">
<meta name="application-name" content="Margin">
<link rel="manifest" href="./manifest.webmanifest">
<link rel="apple-touch-icon" sizes="180x180" href="./icon-180.png">
<link rel="icon" type="image/png" sizes="192x192" href="./icon-192.png">
<title>Margin — Budget with intent</title>
<style>
  :root{
    --ground:#08171F; --panel:#0F2531; --raised:#16323F; --line:#1F4354;
    --ivory:#F4F1E9; --dim:#93AEBB; --faint:#5E8090;
    --jade:#2BE0A4; --cyan:#35D3EE; --blue:#5E9CFF; --violet:#A38BFF;
    --pink:#FF6FA8; --coral:#FF6A54; --amber:#FFB83D; --lime:#B6EE5C;
    --sig:var(--jade);
  }
  *{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
  html,body{margin:0;padding:0;background:var(--ground)}
  body{color:var(--ivory);
    font-family:"Avenir Next","Avenir",system-ui,-apple-system,sans-serif;
    font-size:16px;line-height:1.4;-webkit-font-smoothing:antialiased;
    padding-bottom:calc(72px + env(safe-area-inset-bottom));overscroll-behavior-y:none}
  .tab{font-variant-numeric:tabular-nums;letter-spacing:-.015em}
  button{font:inherit;color:inherit;border:none;background:none;cursor:pointer}
  input,select{font:inherit;color:var(--ivory);background:var(--raised);
    border:1px solid var(--line);border-radius:10px;padding:11px 12px;width:100%}
  input::placeholder{color:var(--faint)}
  input:focus,select:focus,button:focus-visible{outline:2px solid var(--sig);outline-offset:2px}
  .wrap{max-width:500px;margin:0 auto;padding:0 18px}
  .view{display:none}.view.on{display:block}
  h2{font-size:15px;font-weight:600;color:var(--dim);margin:26px 0 10px}
  .dim{color:var(--dim)}.tiny{font-size:13px}.danger{color:var(--coral)}

  /* gauge */
  .gauge{position:relative;padding:12px 0 2px;text-align:center}
  .gauge svg{width:250px;height:196px;display:block;margin:0 auto}
  .ring{fill:none;stroke:#143040;stroke-width:10;stroke-linecap:round}
  .fill{fill:none;stroke:var(--sig);stroke-width:10;stroke-linecap:round;
    filter:drop-shadow(0 0 7px color-mix(in srgb,var(--sig) 55%,transparent));
    transition:stroke-dasharray .55s cubic-bezier(.3,.85,.3,1),stroke .4s}
  .face{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;
    justify-content:center;padding-bottom:20px;pointer-events:none}
  .amt{font-size:51px;font-weight:600;line-height:1;letter-spacing:-.035em}
  .amt .p{font-size:25px;font-weight:500;vertical-align:.33em;margin-right:1px;color:var(--dim)}
  .cap{font-size:13.5px;color:var(--dim);margin-top:7px}
  .pace{font-size:13.5px;color:var(--faint);margin-top:2px}
  .over .amt{color:var(--coral)}

  .seg{display:inline-flex;border:1px solid var(--line);border-radius:999px;overflow:hidden;background:var(--panel)}
  .seg button{padding:7px 16px;font-size:13.5px;font-weight:600;color:var(--faint)}
  .seg button[aria-pressed="true"]{background:var(--raised);color:var(--ivory)}
  .segwrap{text-align:center;margin:2px 0 6px}

  /* envelopes */
  .list{margin-top:10px}
  .row{display:block;width:100%;text-align:left;padding:12px 0 10px;background:none;
    border:none;border-bottom:1px solid var(--line)}
  .row:active{background:rgba(255,255,255,.04)}
  .top{display:flex;justify-content:space-between;align-items:baseline;gap:12px}
  .nm{font-size:16px;font-weight:500;display:flex;align-items:center;gap:9px}
  .dot{width:9px;height:9px;border-radius:50%;flex:none;box-shadow:0 0 8px currentColor}
  .rm{font-size:17px;font-weight:600}
  .rule{height:3px;background:#12313F;margin-top:9px;border-radius:2px;overflow:hidden}
  .rule i{display:block;height:100%;border-radius:2px;transition:width .5s cubic-bezier(.3,.85,.3,1)}

  /* sheet */
  .sheet{position:fixed;inset:0;background:rgba(3,10,14,.76);display:none;align-items:flex-end;z-index:40;
    -webkit-backdrop-filter:blur(4px);backdrop-filter:blur(4px)}
  .sheet.on{display:flex}
  .sheet>div{background:var(--panel);width:100%;max-width:500px;margin:0 auto;
    border-radius:24px 24px 0 0;border-top:1px solid var(--line);
    padding:12px 18px calc(18px + env(safe-area-inset-bottom));max-height:93vh;overflow:auto;
    animation:rise .22s cubic-bezier(.2,.9,.3,1)}
  @keyframes rise{from{transform:translateY(24px);opacity:.4}to{transform:none;opacity:1}}
  .pull{width:34px;height:4px;border-radius:2px;background:#2B5567;margin:0 auto 14px}
  .flex{display:flex;justify-content:space-between;align-items:center;gap:12px}
  .disp{text-align:center;font-size:45px;font-weight:600;letter-spacing:-.035em;padding:14px 0 6px}
  .disp .p{font-size:22px;font-weight:500;vertical-align:.33em;margin-right:1px;color:var(--dim)}
  .disp.zero,.disp.zero .p{color:var(--faint)}
  .quick{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin:10px 0 2px}
  .q{border:1px solid var(--line);background:var(--raised);border-radius:999px;
    padding:13px 2px;font-size:15.5px;font-weight:600;text-align:center}
  .q:active{background:var(--sig);border-color:var(--sig);color:#062018}
  .pad{display:grid;grid-template-columns:repeat(3,1fr);gap:6px;margin-top:10px}
  .key{padding:15px 0;font-size:25px;font-weight:500;text-align:center;border-radius:13px}
  .key:active{background:var(--raised)}
  .go{width:100%;background:var(--sig);color:#062018;border-radius:14px;padding:15px;
    font-size:17px;font-weight:700;margin-top:12px}
  .go[disabled]{background:var(--raised);color:var(--faint)}
  .flat{width:100%;text-align:center;padding:12px;font-size:15px;color:var(--dim);margin-top:4px}
  .note{margin-top:10px;font-size:15px;padding:12px 14px;border-radius:12px}
  textarea{font:inherit;color:var(--ivory);background:var(--raised);border:1px solid var(--line);
    border-radius:10px;padding:11px 12px;width:100%;resize:vertical;line-height:1.45}
  textarea::placeholder{color:var(--faint)}
  textarea:focus{outline:2px solid var(--sig);outline-offset:2px}
  .hint{font-size:12.5px;color:var(--faint);padding:9px 0 0}

  /* history */
  .daybar{display:flex;justify-content:space-between;padding:17px 0 7px;font-size:13px;
    color:var(--faint);border-bottom:1px solid var(--line)}
  .txn{display:flex;justify-content:space-between;align-items:center;gap:12px;width:100%;
    text-align:left;padding:12px 0;border-bottom:1px solid var(--line);background:none}
  .txn:active{background:rgba(255,255,255,.04)}

  .block{background:var(--panel);border:1px solid var(--line);border-radius:15px;padding:14px;margin-bottom:10px}
  .block.flag{border-color:#5A4420;background:#1B2A20}
  .field{margin-bottom:12px}.field:last-child{margin-bottom:0}
  .field label{display:block;font-size:13px;color:var(--dim);margin-bottom:5px}
  .sm{border:1px solid var(--line);background:var(--raised);border-radius:10px;
    padding:9px 14px;font-size:14px;font-weight:500}

  .nav{position:fixed;left:0;right:0;bottom:0;display:flex;background:rgba(8,23,31,.94);
    -webkit-backdrop-filter:blur(14px);backdrop-filter:blur(14px);
    border-top:1px solid var(--line);padding-bottom:env(safe-area-inset-bottom);z-index:20}
  .nav button{flex:1;padding:11px 0 9px;font-size:11px;color:var(--faint);
    display:flex;flex-direction:column;align-items:center;gap:4px;font-weight:500}
  .nav button[aria-current="true"]{color:var(--ivory)}
  .nav svg{width:20px;height:20px;stroke:currentColor;fill:none;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round}

  #toast{position:fixed;left:50%;transform:translateX(-50%);bottom:calc(86px + env(safe-area-inset-bottom));
    background:var(--raised);border:1px solid var(--line);padding:10px 12px 10px 17px;border-radius:999px;
    font-size:14.5px;opacity:0;pointer-events:none;transition:opacity .2s;z-index:50;max-width:92vw;
    display:flex;align-items:center;gap:12px}
  #toast.on{opacity:1;pointer-events:auto}
  #undo{color:var(--sig);font-weight:700;padding:3px 10px;border-radius:999px;background:rgba(43,224,164,.12)}
  .empty{text-align:center;padding:38px 10px;color:var(--faint);font-size:14.5px;line-height:1.6}
  @media (prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important}}


  /* ── Margin 3 visual system ─────────────────────────────── */
  :root{
    --ground:#071116;
    --panel:#0C1B22;
    --raised:#112831;
    --raised2:#16323C;
    --line:rgba(171,216,226,.12);
    --line-strong:rgba(171,216,226,.20);
    --ivory:#F7F8F3;
    --dim:#A7BBC2;
    --faint:#68828C;
    --shadow:0 18px 48px rgba(0,0,0,.28);
  }
  html{background:var(--ground)}
  body{
    min-height:100vh;
    background:
      radial-gradient(circle at 50% -120px, rgba(43,224,164,.13), transparent 330px),
      linear-gradient(180deg,#08171d 0%,#071116 58%,#071116 100%);
    padding-bottom:calc(104px + env(safe-area-inset-bottom));
  }
  body:before{content:"";position:fixed;inset:0;pointer-events:none;z-index:-1;
    background-image:linear-gradient(rgba(255,255,255,.012) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.012) 1px,transparent 1px);
    background-size:28px 28px;mask-image:linear-gradient(to bottom,black,transparent 42%)}
  .wrap{max-width:560px;padding:0 18px 30px}
  .apphead{display:flex;align-items:center;justify-content:space-between;padding:19px 2px 12px;min-height:66px}
  .brand{display:flex;align-items:center;gap:11px;font-size:19px;font-weight:750;letter-spacing:-.025em}
  .brandmark{width:32px;height:32px;border-radius:11px;display:grid;place-items:center;color:#062018;
    background:linear-gradient(145deg,var(--jade),#74F0C4);box-shadow:0 8px 22px rgba(43,224,164,.18)}
  .brandmark svg{width:18px;height:18px;stroke:currentColor;fill:none;stroke-width:2.1;stroke-linecap:round;stroke-linejoin:round}
  .periodpill{font-size:12.5px;color:var(--dim);padding:8px 10px;border-radius:999px;border:1px solid var(--line);background:rgba(15,37,49,.7)}
  .view{padding-top:3px}
  .viewtitle{font-size:28px;font-weight:700;letter-spacing:-.04em;margin:8px 0 3px}
  .viewsub{font-size:13.5px;color:var(--dim);margin-bottom:15px}
  h2{font-size:12px;letter-spacing:.10em;text-transform:uppercase;color:var(--faint);font-weight:700;margin:26px 2px 10px}

  .hero{position:relative;overflow:hidden;background:linear-gradient(160deg,rgba(17,40,49,.94),rgba(10,28,35,.94));
    border:1px solid var(--line);border-radius:28px;padding:11px 12px 15px;box-shadow:var(--shadow)}
  .hero:after{content:"";position:absolute;width:180px;height:180px;border-radius:50%;right:-80px;top:-100px;background:var(--sig);opacity:.08;filter:blur(2px);pointer-events:none}
  .segwrap{margin:4px 0 0;text-align:left;padding-left:4px;position:relative;z-index:2}
  .seg{padding:3px;border:1px solid var(--line);background:rgba(4,16,21,.45);gap:2px}
  .seg button{padding:7px 12px;border-radius:999px;font-size:12px;color:var(--faint)}
  .seg button[aria-pressed="true"]{background:var(--raised2);color:var(--ivory);box-shadow:0 1px 0 rgba(255,255,255,.04) inset}
  .gauge{padding:3px 0 0}
  .gauge svg{width:225px;height:170px}
  .ring{stroke:rgba(123,171,183,.13);stroke-width:9}
  .fill{stroke-width:9;filter:drop-shadow(0 0 10px color-mix(in srgb,var(--sig) 50%,transparent))}
  .face{padding-bottom:9px}
  .amt{font-size:47px;font-weight:690;letter-spacing:-.05em}
  .amt .p{font-size:20px;color:var(--dim)}
  .cap{margin-top:6px;color:var(--dim);font-size:13px}
  .pace{font-size:12.5px;color:var(--faint);margin-top:3px}
  .herofoot{display:grid;grid-template-columns:1fr 1px 1fr;gap:13px;align-items:center;margin:2px 9px 0;padding-top:13px;border-top:1px solid var(--line)}
  .herofoot .divider{width:1px;height:28px;background:var(--line)}
  .herofoot b{display:block;font-size:14px;margin-bottom:2px}.herofoot span{font-size:11.5px;color:var(--faint)}

  .sectionhead{display:flex;align-items:end;justify-content:space-between;margin:22px 2px 8px}
  .sectionhead h2{margin:0;color:var(--ivory);font-size:17px;text-transform:none;letter-spacing:-.02em}
  .sectionhead span{font-size:12px;color:var(--faint)}
  .list{margin-top:0;display:grid;gap:9px}
  .row{padding:14px 14px 13px;background:linear-gradient(160deg,rgba(15,37,49,.86),rgba(12,27,34,.86));
    border:1px solid var(--line);border-radius:17px;box-shadow:0 8px 24px rgba(0,0,0,.10);transition:transform .15s,border-color .15s,background .15s}
  .row:last-child{border-bottom:1px solid var(--line)}
  .row:active{transform:scale(.985);background:var(--raised);border-color:var(--line-strong)}
  .top{align-items:center}.nm{font-size:14.5px;font-weight:600}.rm{font-size:15px;font-weight:700}
  .dot{width:8px;height:8px;box-shadow:0 0 11px currentColor}
  .rule{height:5px;margin-top:11px;background:rgba(3,15,20,.72);border-radius:999px}
  .rule i{border-radius:999px}
  .list .row .top + .rule{opacity:.95}

  .block{background:linear-gradient(160deg,rgba(15,37,49,.90),rgba(12,27,34,.90));border:1px solid var(--line);border-radius:18px;padding:16px;box-shadow:0 8px 26px rgba(0,0,0,.11)}
  .block.flag{border-color:rgba(255,184,61,.28);background:linear-gradient(160deg,rgba(41,36,21,.88),rgba(19,31,28,.92))}
  input,select,textarea{background:#0A1C23;border-color:var(--line-strong);border-radius:13px;padding:12px 13px}
  .sm{background:var(--raised);border-color:var(--line-strong);border-radius:12px;padding:10px 14px}

  .nav{left:50%;right:auto;transform:translateX(-50%);bottom:12px;width:calc(100% - 28px);max-width:530px;border:1px solid var(--line-strong);
    border-radius:24px;background:rgba(11,27,34,.86);padding:6px 7px calc(6px + env(safe-area-inset-bottom));box-shadow:0 18px 50px rgba(0,0,0,.42);
    -webkit-backdrop-filter:blur(22px);backdrop-filter:blur(22px)}
  .nav button{padding:8px 0 7px;border-radius:17px;font-size:10.5px;gap:3px;transition:background .18s,color .18s,transform .18s}
  .nav button[aria-current="true"]{color:var(--ivory);background:rgba(255,255,255,.06)}
  .nav button:active{transform:scale(.96)}
  .nav svg{width:19px;height:19px}

  .sheet{background:rgba(0,8,11,.72);-webkit-backdrop-filter:blur(10px);backdrop-filter:blur(10px)}
  .sheet>div{background:linear-gradient(180deg,#10262f,#0b1b22);border-radius:28px 28px 0 0;border-top:1px solid var(--line-strong);padding:12px 18px calc(22px + env(safe-area-inset-bottom));box-shadow:0 -24px 70px rgba(0,0,0,.46)}
  .pull{width:42px;background:#34525d}
  .disp{font-size:48px;padding:18px 0 10px}
  .quick{gap:7px}.q{border-color:var(--line-strong);background:#102832;padding:12px 2px}
  .pad{gap:5px}.key{padding:14px 0;border-radius:14px}.key:active{background:#18343e}
  .go{border-radius:15px;padding:15px;background:linear-gradient(135deg,var(--sig),color-mix(in srgb,var(--sig) 74%,white));box-shadow:0 10px 26px color-mix(in srgb,var(--sig) 18%,transparent)}
  .go[disabled]{box-shadow:none;background:var(--raised);color:var(--faint)}

  #toast{bottom:calc(102px + env(safe-area-inset-bottom));background:#15303a;border-color:var(--line-strong);box-shadow:0 14px 36px rgba(0,0,0,.34)}
  .daybar{padding:20px 2px 8px;border-bottom:none;text-transform:uppercase;letter-spacing:.09em;font-size:11px}
  .txn{padding:13px 12px;border:1px solid var(--line);border-radius:14px;margin-bottom:7px;background:rgba(13,31,39,.72)}

  @media(min-width:760px){
    body{padding-top:16px}.wrap{max-width:630px}.nav{max-width:600px}.sheet>div{max-width:600px}
    .hero{padding-left:25px;padding-right:25px}.gauge svg{width:245px;height:182px}
  }


  /* ── Margin 1.5 interaction layer ─────────────────────── */
  :root{--spring:cubic-bezier(.22,.92,.28,1.08);--ease-out:cubic-bezier(.2,.8,.2,1)}
  .view.on{animation:viewIn .24s var(--ease-out) both}
  @keyframes viewIn{from{opacity:.35;transform:translateY(7px)}to{opacity:1;transform:none}}

  /* envelopes: drag-to-reorder */
  .envelope-wrap{position:relative;border-radius:17px;transition:transform .22s var(--spring),filter .22s,opacity .22s;will-change:transform}
  .envelope-wrap.dragging{z-index:12;transform:scale(1.018);filter:drop-shadow(0 18px 26px rgba(0,0,0,.34));opacity:.96}
  .envelope-wrap.drag-target{transform:scale(.985);opacity:.72}
  .drag-handle{width:24px;height:32px;margin:-7px -2px -7px -6px;display:grid;place-items:center;color:var(--faint);border-radius:9px;touch-action:none;cursor:grab;flex:none}
  .drag-handle:active{cursor:grabbing;background:rgba(255,255,255,.05);color:var(--ivory)}
  .drag-handle svg{width:14px;height:18px;fill:currentColor;opacity:.75}
  .reorder-tip{display:flex;align-items:center;gap:6px;color:var(--faint);font-size:11.5px;margin:-2px 2px 9px}
  .reorder-tip svg{width:13px;height:13px;fill:currentColor}

  /* swipeable history */
  .swipe-shell{position:relative;overflow:hidden;border-radius:14px;margin-bottom:7px;background:#0b2028}
  .swipe-shell .txn{margin-bottom:0;will-change:transform;transition:transform .28s var(--spring),background .18s;touch-action:pan-y}
  .swipe-actions{position:absolute;inset:0 0 0 auto;display:flex;justify-content:flex-end;align-items:stretch;width:148px;z-index:0}
  .swipe-action{width:74px;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:4px;font-size:11px;font-weight:700;color:var(--ivory)}
  .swipe-action svg{width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
  .swipe-action.repeat{background:#163d3a;color:#95f4d3}.swipe-action.delete{background:#4b2323;color:#ffaaa0}
  .swipe-shell.open .txn{transform:translateX(-148px)}

  /* shared nav indicator */
  .nav{overflow:hidden}
  .nav-indicator{position:absolute;left:7px;top:6px;bottom:calc(6px + env(safe-area-inset-bottom));width:calc((100% - 14px)/4);border-radius:17px;background:rgba(255,255,255,.065);box-shadow:inset 0 1px 0 rgba(255,255,255,.04);transition:transform .36s var(--spring);pointer-events:none}
  .nav button{position:relative;z-index:1;background:transparent!important}

  /* draggable spring sheet */
  .sheet{display:flex!important;visibility:hidden;opacity:0;pointer-events:none;transition:opacity .20s ease,visibility 0s linear .32s}
  .sheet.on{visibility:visible;opacity:1;pointer-events:auto;transition:opacity .20s ease,visibility 0s}
  .sheet>div{transform:translateY(calc(100% + 28px));transition:transform .36s var(--spring);will-change:transform}
  .sheet.on>div{transform:translateY(var(--sheet-drag,0px))}
  .sheet.dragging>div{transition:none}
  .pull{touch-action:none;cursor:grab;position:relative}
  .pull:after{content:"";position:absolute;inset:-12px -30px;}
  .sheethint{text-align:center;font-size:10.5px;color:var(--faint);margin:-7px 0 10px;opacity:.72}

  /* motion feedback */
  .pop{animation:tinyPop .34s var(--spring)}
  @keyframes tinyPop{0%{transform:scale(.92);opacity:.55}65%{transform:scale(1.035)}100%{transform:none;opacity:1}}
  .rule i{transition:width .55s var(--spring),background .3s ease}
  .fill{transition:stroke-dasharray .65s var(--spring),stroke .35s ease}
  .q,.key,.sm,.go{transition:transform .14s ease,background .18s,border-color .18s,box-shadow .18s}
  .q:active,.key:active,.sm:active,.go:active{transform:scale(.965)}
  .amt,.rm{font-variant-numeric:tabular-nums}

  .pwa-state{display:flex;align-items:center;gap:9px}.pwa-dot{width:8px;height:8px;border-radius:50%;background:var(--amber);box-shadow:0 0 10px currentColor;color:var(--amber)}
  .pwa-state.ready .pwa-dot{background:var(--jade);color:var(--jade)}
  .versiontag{display:inline-flex;align-items:center;padding:4px 7px;border:1px solid var(--line);border-radius:999px;color:var(--faint);font-size:10.5px;margin-left:5px}

  @media (prefers-reduced-motion:reduce){.view.on,.pop{animation:none!important}.sheet>div,.nav-indicator,.swipe-shell .txn,.envelope-wrap{transition:none!important}}

</style>
</head>
<body>
<main class="wrap">
  <header class="apphead">
    <div class="brand"><span class="brandmark"><svg viewBox="0 0 24 24"><path d="M5 16.5 9.5 12l3 3L19 8.5"/><path d="M15.5 8.5H19V12"/></svg></span><span>Margin</span></div>
    <span class="periodpill">Spend with intent</span>
  </header>

